# Public tree = contracts + the assurance layer (build config, tests, tooling,
# CI, scope/security docs). Everything else — internal planning, audit working
# notes, sim runs, build output — stays local.
#
# Default is PRIVATE: `/*` ignores everything at root; only paths explicitly
# un-ignored below are ever published. Anything new/unknown stays private until
# it is deliberately added here.
/*

# ── Source ──────────────────────────────────────────────────────────────
!/contracts

# ── Build & reproducibility (pinned toolchain) ──────────────────────────
!/foundry.toml
!/foundry.lock
!/remappings.txt
!/.gitmodules
!/lib
!/hardhat.config.js
!/package.json
!/package-lock.json
!/.env.example
!/Makefile

# ── Tests (full suite: unit, integration, fuzz, invariant, gas, ...) ─────
!/test

# ── Tooling: deploy, address prediction, drift gates, storage-layout oracle
!/scripts
/scripts/v65_flip_rename.py

# ── CI ──────────────────────────────────────────────────────────────────
!/.github

# ── Scope, security policy, findings dispositions, reference docs ───────
!/scope.txt
!/out_of_scope.txt
!/KNOWN-ISSUES.md
!/SECURITY.md
!/ECONOMIC_DISCLOSURES.md
!/TERMS.md
!/docs
!/deployments

# Publish the auditor's reference set; keep planning and generated reports local.
docs/*
!docs/README.md
!docs/AUDIT.md
!docs/ARCHITECTURE.md
!docs/VERIFICATION.md
!docs/TEST_REVIEW.md
!docs/DECIMATOR-BATTLE.md
!docs/CRAPS-PREFERENCES.md
!docs/DEGENERETTE-BET-QUEUE.md
!docs/DEGENERETTE-SINGLE-SYMBOL-MATH.md
!docs/DEITY-BOONS.md
!docs/WWXRP-BOONS.md
!docs/DEITY-PASS-CUSTOMIZATION.md
!docs/TOKEN-UNITS.md
!docs/abi/
docs/abi/*
!docs/abi/DeityPassCustomizationRenderer.json
!docs/abi/Decimator.json
!docs/audit/
docs/audit/*
!docs/audit/RNG-DOMAINS.md
!docs/audit/RUN53-FINAL-CONTRACTS.md
!docs/audit/snapshot.json
!docs/audit/source-sha256.txt
!docs/audit/verification-sha256.txt

# ── Meta ────────────────────────────────────────────────────────────────
!/README.md
!/LICENSE
!/.gitignore

# Local junk that can appear inside tracked dirs
*.sol.bak

# Python bytecode from the scripts/lib extractors
__pycache__/

# Kept locally and in history, not in the audit tree
docs/archive/
deployments/
test/REGRESSION-BASELINE-*.md
scripts/craps-high-water-system-sim.cpp
scripts/craps-system-sim.cpp
scripts/craps-emissions-report.py
scripts/craps-engine-ev-calibration.py
scripts/craps-entry-pricing-analysis.py
scripts/craps-ev-analysis.py
scripts/craps-high-roller-incentive-proposal.py
scripts/check-craps-progressive-parity.sh
scripts/ens-register.js
scripts/ens-sepolia-proof.js
scripts/ens-sepolia-register.js
scripts/fork-probe.js
scripts/fork-run.sh
scripts/lib/ensForwardConfirmed.js
scripts/bytecode-manifest.sh
docs/CRAPS-HIGH-WATER-*.tsv
