# Deployer private key (without 0x prefix or with — both work)
DEPLOYER_PRIVATE_KEY=

# Network RPC URLs
RPC_URL=
HARDHAT_FORK_URL=

# Block explorer verification
ETHERSCAN_API_KEY=

# External contract addresses (Ethereum Mainnet defaults)
STETH_TOKEN=0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84
LINK_TOKEN=0x514910771AF9Ca656af840dff83E8264EcF986CA

# ⚠ VRF: the contracts target Chainlink VRF **V2.5 Plus**
# (contracts/interfaces/IVRFCoordinator.sol — RandomWordsRequest with extraArgs).
# The values below were the V2-era mainnet pair and are WRONG for this codebase:
#   VRF_COORDINATOR=0x271682DEB8C4E0901D1a1550aD2e64D568E69909  # V2 — do NOT use
#   VRF_KEY_HASH=0x8af398995b04c28e9951adb9721ef74c74f93e6a478f39e7e0777be13527e7ef
# V2's addConsumer takes uint64, V2.5's takes uint256 — different selector — so a
# V2 coordinator reverts DegenerusAdmin's constructor at contract #24 of 28,
# after the first 23 deploys are already paid for and the nonce sequence is spent.
# Correct V2.5 pair — Ethereum Mainnet (gas lanes: 200/500/1000 gwei):
#   200 gwei  0x8077df514608a09f83e4e8d300645594e5d7234665448ba83f51a50f842bd3d9
#   500 gwei  0x3fd2fec10d06ee8f65e7f2e95f5c56511359ece3f33960ad8a866ae24a8ff10b
#  1000 gwei  0xc6bf2e7b88e5cfbb4946ff23af846494ae1f3c65270b79ee7876c9aa99d3d45f
# Sepolia V2.5: coordinator 0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B,
#               500 gwei lane 0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
# Source: https://docs.chain.link/vrf/v2-5/supported-networks
VRF_COORDINATOR=0xD7f86b4b8Cae7D942340FF628F82735b7a20893a
VRF_KEY_HASH=0x8077df514608a09f83e4e8d300645594e5d7234665448ba83f51a50f842bd3d9

# Optional: ENS reverse registrar. The setName calls are CONSTRUCTOR-ONLY across
# all 17 labels — leave this unset at deploy and the reverse names can never be
# set afterwards. Mainnet L1 ReverseRegistrar; Base uses its L2ReverseRegistrar
# (same setName(string) selector). Unset => the constant stays address(0) and
# every constructor skips its setName.
ENS_REVERSE_REGISTRAR=

# Mainnet-fork rehearsal (scripts/fork-run.sh). Archive-capable RPC to fork from;
# FORK_BLOCK pins a block so runs are reproducible.
MAINNET_FORK_URL=
FORK_BLOCK=

WXRP=0x0000000000000000000000000000000000000000

# Optional: pre-seed affiliate codes at deployment.
# Format: JSON array of { owner, code, kickbackPct } objects.
# - owner: address
# - code: bytes32 hex (0x...) OR short ASCII label (<=31 chars)
# - kickbackPct: integer 0-25 (optional, defaults to 0)
# Example:
# AFFILIATE_BOOTSTRAP_JSON=[{"owner":"0xabc...","code":"KOL1","kickbackPct":10}]
AFFILIATE_BOOTSTRAP_JSON=

# Optional: pre-seed player -> referral code mappings at deployment.
# Format: JSON array of { player, code } objects.
# - player: address
# - code: bytes32 hex (0x...) OR short ASCII label (<=31 chars)
# Example:
# AFFILIATE_PREFERRALS_JSON=[{"player":"0xdef...","code":"KOL1"}]
AFFILIATE_PREFERRALS_JSON=
