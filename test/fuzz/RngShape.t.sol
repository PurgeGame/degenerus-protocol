pragma solidity 0.8.38;
import {Test} from "forge-std/Test.sol";
import {EntropyLib} from "../../contracts/libraries/EntropyLib.sol";
import {RngTags} from "../../contracts/libraries/RngTags.sol";

contract RngShapeTest is Test {
    function testFuzz_FixedWidthHashMatchesAbi(uint256 tag, uint256 word, uint256 a, uint256 b) public pure {
        assertEq(EntropyLib.hash2(tag, word), uint256(keccak256(abi.encode(tag, word))));
        assertEq(EntropyLib.hash3(tag, word, a), uint256(keccak256(abi.encode(tag, word, a))));
        assertEq(EntropyLib.hash4(tag, word, a, b), uint256(keccak256(abi.encode(tag, word, a, b))));
    }

