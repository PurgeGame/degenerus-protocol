pragma solidity ^0.8.26;

import {DeployProtocol} from "../fuzz/helpers/DeployProtocol.sol";
import {WhaleSybilHandler} from "../fuzz/handlers/WhaleSybilHandler.sol";
import {SolvencyObligations} from "../fuzz/helpers/SolvencyObligations.sol";
import {console} from "forge-std/console.sol";

/// @notice Exact finite replays of saved deep-campaign solvency counterexamples.
contract DeepWhaleSolvencyReplay is DeployProtocol {
    WhaleSybilHandler internal handler;
    uint256 internal firstEthOnlyShortfall = type(uint256).max;

    function setUp() public {
        _deployProtocol();
        vm.warp(block.timestamp + 1 days);
        handler = new WhaleSybilHandler(game, mockVRF, 3, 20);
        assertEq(mockStETH.balanceOf(address(game)), 0, "replay must begin without stETH backing");
    }

    function _step(uint256 index, address sender, bytes memory data) internal {
        vm.prank(sender);
        (bool success,) = address(handler).call(data);
        // The original invariant campaign uses fail_on_revert=false.
        if (!success) console.log("reverted replay action", index);
        uint256 owed = SolvencyObligations.obligations(game);
        if (address(game).balance < owed && firstEthOnlyShortfall == type(uint256).max) {
            firstEthOnlyShortfall = index;
        }
        assertGe(SolvencyObligations.backing(game), owed, "saved deep replay: ETH + stETH covers obligations");
        assertGe(handler.ghost_minObligationRatio(), 10_000, "saved deep replay: tracked ratio covers obligations");
    }

    function _assertReplayEvidence(uint256 expectedEthOnlyShortfall) internal view {
        assertEq(firstEthOnlyShortfall, expectedEthOnlyShortfall, "saved ETH-only failure step must be reproduced");
        assertGt(mockStETH.balanceOf(address(game)), 0, "saved actions must exercise automatic staking");
        assertGt(handler.ghost_whaleSuccessful(), 0, "saved whale purchases must execute");
        uint256 owed = SolvencyObligations.obligations(game);
        assertLt(address(game).balance, owed, "saved trace must expose the ETH-only oracle mismatch");
        assertEq(SolvencyObligations.backing(game), owed, "saved trace has exactly covered obligations");
    }

    /// @dev Starting from each saved mixed-custody state, independently remove one wei from
    ///      each asset. Obligations are unchanged; the exact check and the existing handler's
    ///      next successful purchase must both detect the deficit. Snapshots keep these fault
    ///      injections separate from each other and from the saved calldata replay.
    function _assertOneWeiShortages() internal {
        uint256 beforeFault = vm.snapshotState();
        uint256 owed = SolvencyObligations.obligations(game);
        uint256 ethBalance = address(game).balance;
        uint256 stethBalance = mockStETH.balanceOf(address(game));
        assertGt(ethBalance, 0, "ETH shortage control requires native custody");
        assertGt(stethBalance, 0, "stETH shortage control requires staked custody");

        vm.deal(address(game), ethBalance - 1);
        assertEq(SolvencyObligations.obligations(game), owed, "missing ETH must not change obligations");
        _assertShortfallAndTrackPurchase();
        assertTrue(vm.revertToState(beforeFault), "restore saved state after missing ETH control");

        vm.prank(address(game));
        assertTrue(mockStETH.transfer(address(0xDEAD), 1), "remove one wei of stETH from Game custody");
        assertEq(mockStETH.balanceOf(address(game)), stethBalance - 1, "stETH control must remove exactly one wei");
        assertEq(SolvencyObligations.obligations(game), owed, "missing stETH must not change obligations");
        _assertShortfallAndTrackPurchase();
        assertTrue(vm.revertToStateAndDelete(beforeFault), "restore saved state after missing stETH control");
    }

    function _assertShortfallAndTrackPurchase() internal {
        uint256 owed = SolvencyObligations.obligations(game);
        assertEq(SolvencyObligations.backing(game), owed - 1, "exact oracle must detect a one-wei deficit");
        uint256 successfulBefore = handler.ghost_sybilSuccessful();
        handler.sybilPurchase(0);
        assertEq(handler.ghost_sybilSuccessful(), successfulBefore + 1, "shortage control must reach handler tracking");
        assertEq(
            SolvencyObligations.backing(game),
            SolvencyObligations.obligations(game) - 1,
            "successful purchase must preserve the injected one-wei deficit"
        );
        assertLt(handler.ghost_minObligationRatio(), 10_000, "handler must record even a one-wei backing deficit");
    }

