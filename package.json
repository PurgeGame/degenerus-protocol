{
  "name": "degenerus-contracts",
  "version": "1.0.0",
  "description": "Degenerus Protocol - Smart Contracts",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "python3 scripts/test-hardhat-groups.py",
    "test:stat": "hardhat test test/stat/*.test.js",
    "test:gas": "hardhat test test/gas/*.test.js",
    "test:unit": "hardhat test test/unit/*.test.js",
    "test:evt-uni": "hardhat test test/unit/EventSurfaceUnification.test.js test/unit/LootboxWholeTicket.test.js test/unit/JackpotTicketRollSilentColdBust.test.js",
    "test:integration": "hardhat test test/integration/*.test.js",
    "test:deploy": "hardhat test test/deploy/*.test.js",
    "test:access": "hardhat test test/access/*.test.js",
    "test:edge": "hardhat test test/edge/*.test.js",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "coverage": "hardhat coverage"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "degenerus",
    "smart-contracts"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "^17.3.1",
    "hardhat": "^2.28.3",
    "solidity-coverage": "^0.8.17"
  }
}
