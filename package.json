{
  "name": "degenerus-contracts",
  "version": "1.0.0",
  "description": "Degenerus Protocol - Smart Contracts",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "python3 scripts/test-hardhat-groups.py",
    "test:stat": "hardhat test test/stat/*.test.js",
    "test:gas": "hardhat test test/gas/*.test.js",
    "test:unit": "hardhat test test/unit/*.test.js",
    "test:evt-uni": "hardhat test test/unit/EventSurfaceUnification.test.js test/edge/LootboxAutoResolveRegression.test.js test/unit/LootboxWholeTicket.test.js test/unit/JackpotTicketRollSilentColdBust.test.js",
    "test:integration": "hardhat test test/integration/*.test.js",
    "test:deploy": "hardhat test test/deploy/*.test.js",
    "test:access": "hardhat test test/access/*.test.js",
    "test:edge": "hardhat test test/edge/*.test.js",
    "agent": "node agent/src/index.js",
    "agent:local": "node agent/src/index.js --mode local --steps 80 --drive-every 3",
    "agent:live": "node agent/src/index.js --mode live",
    "agent:test": "node --test agent/test/unit.test.js",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "coverage": "hardhat coverage",
    "slither": "unset VIRTUAL_ENV && slither . --filter-paths 'node_modules|mocks' --exclude naming-convention,solc-version,low-level-calls,assembly,too-many-digits,similar-names,dead-code",
    "fuzz": "forge test --match-path 'test/fuzz/*' -vv"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "degenerus",
    "smart-contracts"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "^17.3.1",
    "hardhat": "^2.28.3",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
